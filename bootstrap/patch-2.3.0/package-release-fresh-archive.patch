--- a/package-release.sh
+++ b/package-release.sh
@@ -16,6 +16,9 @@
 APK_OUT="$OUT/$APK_NAME"
 SOURCE_OUT="$OUT/$SOURCE_NAME"
 cp "$APK_SRC" "$APK_OUT"
+# zip -r updates an existing archive but does not remove stale entries.
+# Always create a fresh source archive for a deterministic, clean release.
+rm -f "$SOURCE_OUT"
 APK_SHA="$(sha256sum "$APK_OUT" | awk '{print $1}')"
 APK_SIZE="$(wc -c < "$APK_OUT" | tr -d ' ')"
 APK_URL="https://github.com/Krenas/DNS-Connect/releases/download/$TAG/$APK_NAME"
@@ -26,7 +29,8 @@
   cd "$ROOT"
   zip -q -r "$SOURCE_OUT" . \
     -x './build/*' './build/**' './.git/*' './.git/**' './*.apk' './*.zip' './*.jks' './*.keystore' \
-       './*password*' './BUILD-*.log' './release-output/*' './release-output/**'
+       './*password*' './BUILD-*.log' './release-output/*' './release-output/**' \
+       '*.idsig' '*.orig' '*.rej'
 )
 SOURCE_SHA="$(sha256sum "$SOURCE_OUT" | awk '{print $1}')"
 SOURCE_SIZE="$(wc -c < "$SOURCE_OUT" | tr -d ' ')"
@@ -51,6 +55,7 @@
 - Physical Android device, live network, Quick Settings/widget runtime and installer flow: NOT TESTED
 REPORT
 PACK="$OUT/DNS-Connect-$VERSION-release-pack.zip"
+rm -f "$PACK"
 ASSETS=("$APK_NAME" "$SOURCE_NAME" "DNS-Connect-$VERSION-SHA256SUMS.txt" "DNS-Connect-$VERSION-QA.md" latest.json release.json)
 [[ ! -f "$OUT/DNS-Connect-$VERSION-BUILD.log" ]] || ASSETS+=("DNS-Connect-$VERSION-BUILD.log")
 (cd "$OUT" && zip -q "$PACK" "${ASSETS[@]}")
